{
  "name": "cerca-combis-demo",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "server": "node --env-file-if-exists=.env server/index.js",
    "driver:create": "node --env-file-if-exists=.env server/create-driver.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "cloudflare:login": "wrangler login --scopes account:read user:read workers:write workers_scripts:write",
    "cloudflare:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "cloudflare:dev": "wrangler dev --port 8790 --ip 127.0.0.1",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "test:cloudflare": "node --test cloudflare/integration.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"server/**/*.js\" \"cloudflare/**/*.js\" \"tests/**/*.js\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"server/**/*.js\" \"cloudflare/**/*.js\" \"tests/**/*.js\" \"*.config.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.0.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "prettier": "3.9.9",
    "vite": "^8.0.0",
    "wrangler": "^4.149.0"
  }
}
