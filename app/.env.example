# Copia como .env; no agregues el archivo .env a Git.
PORT=8787
DATABASE_PATH=./data/cerca.sqlite
# Dirección HTTPS de la web al alojarla; también se usa para los QR.
PUBLIC_APP_URL=https://cerca.tu-dominio.mx/
ALLOWED_ORIGINS=https://cerca.tu-dominio.mx,https://localhost,http://localhost,http://127.0.0.1:5173
# Se incorporan a la app Android al compilar: no son secretos.
VITE_PUBLIC_API_URL=https://cerca.tu-dominio.mx/api
VITE_PUBLIC_APP_URL=https://cerca.tu-dominio.mx/
# Para compose.yaml: dominio que apunta al servidor.
CERCA_DOMAIN=cerca.tu-dominio.mx
